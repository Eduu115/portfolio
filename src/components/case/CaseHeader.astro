---
import { LINKS } from '../../config';
import { getLang, localizePath, t } from '../../i18n/utils';
import Icon from '../Icon.astro';

const lang = getLang(Astro.url);
const tr = t(lang);
const facts = [
  { k: tr('case.k.role'), v: tr('home.work.aa.v.role') },
  { k: tr('case.k.period'), v: tr('home.work.aa.v.period'), nums: true },
  { k: tr('case.k.core'), v: tr('case.v.core') },
];
const links = [
  { href: LINKS.apiArena, label: 'apiarena.net', translate: 'no' as const },
  { href: LINKS.apiArenaRepo, label: tr('common.github') },
];
---

<section
  aria-labelledby="cs-title"
  class="wrap flex flex-col gap-8 pt-12 pb-14 max-md:gap-[18px] max-md:pt-6 max-md:pb-8"
>
  <a
    href={`${localizePath('/', lang)}#work`}
    class="inline-flex min-h-11 items-center gap-2 self-start text-[14px] font-medium text-muted no-underline max-md:font-normal"
  >
    <Icon name="arrow-left" />{tr('case.back')}
  </a>
  <div class="flex flex-col gap-5 max-md:contents">
    <p class="mono text-[13px] text-muted max-md:text-[12px]">{tr('case.eyebrow')}</p>
    <h1 id="cs-title" class="font-display t-case-hero max-md:text-[64px] max-md:leading-[.9]" translate="no">
      API Arena
    </h1>
    <p class="max-w-[34em] text-[22px] leading-[1.45] text-ink max-md:text-[18px]">{tr('case.lead')}</p>
  </div>
  <dl
    class="grid grid-cols-[repeat(auto-fit,minmax(min(220px,100%),1fr))] gap-6 border-t border-hairline pt-7 max-md:grid-cols-2 max-md:gap-x-4 max-md:gap-y-[18px] max-md:pt-5 max-md:text-[15px]"
  >
    {
      facts.map(({ k, v, nums }) => (
        <div class="flex flex-col gap-[6px] max-md:gap-1">
          <dt class="label">{k}</dt>
          <dd class:list={['text-ink', { 'tabular-nums': nums }]}>{v}</dd>
        </div>
      ))
    }
    <div class="flex flex-col gap-[6px] max-md:gap-1">
      <dt class="label">{tr('case.k.links')}</dt>
      <dd class="flex gap-5 max-md:flex-col max-md:gap-0">
        {
          links.map((l) => (
            <a href={l.href} class="group inline-flex items-center gap-2 font-semibold text-ink no-underline">
              <span translate={l.translate}>{l.label}</span>
              <Icon
                name="arrow-up-right"
                size={14}
                class="transition-transform duration-200 ease-out-expo motion-safe:group-hover:[transform:translate(2px,-2px)] max-md:hidden"
              />
            </a>
          ))
        }
      </dd>
    </div>
  </dl>
</section>
