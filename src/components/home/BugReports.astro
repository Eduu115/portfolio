---
import { getLang, t } from '../../i18n/utils';
import KeyValue from '../KeyValue.astro';

interface Props {
  /** Adds the "lesson" row (case study only). */
  withLesson?: boolean;
}

const { withLesson = false } = Astro.props;
const tr = t(getLang(Astro.url));
const bugs = (['1', '2'] as const).map((n) => ({
  title: tr(`bugs.${n}.title`),
  items: [
    { k: tr('bugs.k.symptom'), v: tr(`bugs.${n}.symptom`) },
    { k: tr('bugs.k.cause'), v: tr(`bugs.${n}.cause`) },
    { k: tr('bugs.k.fix'), v: tr(`bugs.${n}.fix`), ink: true },
    ...(withLesson ? [{ k: tr('bugs.k.lesson'), v: tr(`bugs.${n}.lesson`) }] : []),
  ],
}));
---

<section aria-labelledby="bugs-title" data-reveal class="wrap flex flex-col gap-10 pb-28 max-md:gap-7 max-md:pb-[72px]">
  <h2 id="bugs-title" class="font-display t-h2 max-md:text-[40px]">{tr('bugs.title')}</h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(480px,100%),1fr))] gap-6 max-md:flex max-md:flex-col max-md:gap-7">
    {
      bugs.map((b, i) => (
        <article
          class:list={[
            'flex flex-col gap-6 border-t-2 pt-8 max-md:gap-[18px] max-md:pt-6',
            i === 0 ? 'border-accent' : 'border-hairline-strong',
          ]}
        >
          <h3 class="t-title-lg max-md:text-[22px] max-md:leading-[1.25] max-md:tracking-normal">{b.title}</h3>
          <KeyValue
            class="grid-cols-[80px_minmax(0,1fr)] gap-y-4 max-md:grid-cols-[72px_minmax(0,1fr)] max-md:gap-y-[14px]"
            items={b.items}
          />
        </article>
      ))
    }
  </div>
</section>
