---
import { Picture } from 'astro:assets';
import portrait from '../../assets/eduardo-portrait.jpg';
import { EMAIL } from '../../config';
import { getLang, t } from '../../i18n/utils';
import Button from '../Button.astro';
import Icon from '../Icon.astro';

const tr = t(getLang(Astro.url));
---

<section
  aria-labelledby="hero-title"
  class="wrap flex flex-wrap items-center gap-x-[72px] gap-y-12 pt-[72px] pb-[104px] max-md:flex-col max-md:items-stretch max-md:gap-[22px] max-md:pt-12 max-md:pb-12"
>
  <div class="flex min-w-0 flex-[7_1_560px] flex-col gap-7 max-md:contents">
    <p class="rise text-[22px] leading-[1.3] font-medium text-ink max-md:text-[19px]">{tr('home.hero.greeting')}</p>
    <h1
      id="hero-title"
      class="font-display t-hero hero-title rise max-md:text-[46px] max-md:leading-[.98]"
      style="animation-delay: 60ms"
    >
      {tr('home.hero.title.before')}<span class="text-accent-text">{tr('home.hero.title.accent')}</span>{
        tr('home.hero.title.after')
      }
    </h1>
    <p class="t-body-lg rise max-w-[32em] max-md:text-[17px]" style="animation-delay: 120ms">{tr('home.hero.sub')}</p>
    <div class="rise flex flex-wrap gap-3 pt-1 max-md:flex-nowrap max-md:gap-[10px]" style="animation-delay: 180ms">
      <Button href="#work" data-testid="hero-cta" class="max-md:flex-[1_1_0]">
        {tr('home.hero.ctaWork')}<Icon name="arrow-right" />
      </Button>
      <Button href={`mailto:${EMAIL}`} variant="secondary" class="max-md:flex-[1_1_0]">
        <Icon name="envelope-simple" class="max-md:hidden" />{tr('common.emailMe')}
      </Button>
    </div>
  </div>

  <figure
    class="rise ml-auto max-w-[460px] min-w-0 flex-[5_1_360px] max-lg:ml-0 max-md:mt-[14px] max-md:max-w-none max-md:flex-none"
    style="animation-delay: 200ms"
  >
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      widths={[390, 460, 780, 920]}
      sizes="(min-width: 1024px) 460px, 100vw"
      alt={tr('home.hero.photoAlt')}
      loading="eager"
      fetchpriority="high"
      class="aspect-[4/5] w-full rounded-[12px] border border-hairline object-cover [filter:grayscale(1)_contrast(1.04)]"
    />
  </figure>
</section>
