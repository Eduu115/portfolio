---
import Icon from './Icon.astro';

interface Props {
  href: string;
  iconSize?: number;
  iconClass?: string;
  class?: string;
}

const { href, iconSize = 14, iconClass, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-2 font-semibold text-ink no-underline max-md:min-h-11',
    className,
  ]}
  ><slot /><Icon
    name="arrow-up-right"
    size={iconSize}
    class:list={[
      'transition-transform duration-200 ease-out-expo motion-safe:group-hover:[transform:translate(2px,-2px)]',
      iconClass,
    ]}
  /></a
>
