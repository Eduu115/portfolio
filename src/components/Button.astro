---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'primary' | 'secondary' | 'dark';
}

const { variant = 'primary', class: className, ...rest } = Astro.props;
const variants = {
  primary: 'bg-accent text-on-accent border-accent hover:bg-accent-hover',
  secondary: 'bg-surface-1 text-ink border-hairline-strong hover:border-muted',
  dark: 'bg-[#0B0C0E] text-[#F2F3F5] border-[#0B0C0E] hover:bg-[#1A1D21]',
};
---

<a
  class:list={[
    'inline-flex h-12 cursor-pointer items-center justify-center gap-[10px] whitespace-nowrap rounded-[8px] border px-5 text-[15px] leading-none font-semibold no-underline transition-[transform,background-color,border-color] duration-[180ms] ease-out-expo motion-safe:active:[transform:scale(.98)] max-md:px-[18px]',
    variants[variant],
    className,
  ]}
  {...rest}><slot /></a
>
