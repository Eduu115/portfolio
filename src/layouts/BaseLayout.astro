---
import '../styles/global.css';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import martianUrl from '@fontsource-variable/martian-mono/files/martian-mono-latin-standard-normal.woff2?url';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SkipLink from '../components/SkipLink.astro';
import { SITE_URL, EMAIL, GITHUB, LINKEDIN } from '../config';
import { altPath, getLang, t } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  /** false on the 404 pages: no canonical, alternates or social cards. */
  seo?: boolean;
  /** Person JSON-LD (home only, plan section 12). */
  person?: boolean;
}

const { title, description, seo = true, person = false } = Astro.props;
const lang = getLang(Astro.url);
const tr = t(lang);
const abs = (path: string) => new URL(path, SITE_URL).href.replace(/\/$/, '');
const canonical = abs(altPath(Astro.url, lang));
const alternates = { en: abs(altPath(Astro.url, 'en')), es: abs(altPath(Astro.url, 'es')) };
const ogImage = new URL(`/og/og-${lang}.png`, SITE_URL).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Eduardo Serrano Trenado',
  jobTitle: 'Backend Software Engineer',
  url: abs('/'),
  email: `mailto:${EMAIL}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  worksFor: { '@type': 'Organization', name: 'Deloitte' },
  sameAs: [LINKEDIN, GITHUB],
  knowsAbout: ['Java', 'Spring Boot', 'Apache Kafka', 'PostgreSQL', 'Docker', 'SAP ABAP'],
};
---

<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        try {
          const s = localStorage.getItem('theme');
          const t = s === 'light' || s === 'dark' ? s : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.dataset.theme = t;
          document.documentElement.classList.add('js');
        } catch { document.documentElement.dataset.theme = 'dark'; }
      })();
    </script>
    <meta name="theme-color" content="#0B0C0E" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F4F5F6" media="(prefers-color-scheme: light)" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={archivoUrl} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={martianUrl} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {
      seo && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="es" href={alternates.es} />
          <link rel="alternate" hreflang="x-default" href={alternates.en} />
          <meta property="og:type" content="website" />
          <meta property="og:title" content={title} />
          {description && <meta property="og:description" content={description} />}
          <meta property="og:url" content={canonical} />
          <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={tr('meta.ogAlt')} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {person && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SkipLink />
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
